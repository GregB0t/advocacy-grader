# Copy to .env (or run `npm run setup`, which writes .env for you and verifies
# the key). Everything here is optional in the sense that the tool degrades
# honestly without it — each skipped capability says so in its output rather
# than pretending.

# ScrapingBee. Used only as an escalation path when a site rejects direct,
# honestly-identified fetches (e.g. a 403 on the homepage). Without it, direct
# fetches still work and blocked sites are reported as blocked.
SCRAPINGBEE_API_KEY=

# Anthropic. Turns on rephrase-only narration of the findings prose in live
# reports (lib/narrate.js). Without it, deterministic prose ships — complete
# and identical in substance. The model never assigns scores either way.
#ANTHROPIC_API_KEY=

# Lead capture webhook (e.g. a Google Apps Script bound to a Sheet whose
# doPost appends the posted JSON as a row). Leads always also land in
# out/leads.jsonl, with or without this.
#LEADS_WEBHOOK_URL=

# Cloudflare Turnstile server secret. Without it the email gate skips the
# challenge and says so in its result.
#TURNSTILE_SECRET_KEY=

# Server port for `npm run serve` (default 8787).
#PORT=8787
